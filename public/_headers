# ============================================================================
# ONYXMEN.MY — CLOUDFLARE PAGES SECURITY & SUB-SECOND CACHE HEADERS (MS-008)
# Target Domain: https://www.onyxmen.my
# Performance Budget: LCP < 0.8s | CLS = 0.00
# ============================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self' https://www.onyxmen.my https://onyxmen.my; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://www.onyxmen.my https://onyxmen.my data: blob:; connect-src 'self' https://formsubmit.co https://api.web3forms.com https://api.indexnow.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co https://api.web3forms.com https://wa.me

/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=1800, s-maxage=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

/indexnow-key.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, immutable

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon*.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo-512x512.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
